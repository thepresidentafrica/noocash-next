{
  "name": "noocash",
  "version": "0.0.5",
  "private": true,
  "scripts": {
    "dev": "next dev --port 8866",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cs": "changeset",
    "vs": "changeset version",
    "tag": "changeset tag",
    "release": "standard-version --tag-prefix noocash@ && git push --follow-tags",
    "1st": "standard-version --first-release --tag-prefix \"$(node -p \"require('./package.json').name\")@\" && git push --follow-tags",
    "mg": "npx prisma migrate dev && npx prisma generate",
    "mg:prod": "npx prisma db push && npx prisma generate",
    "postinstalld": "pnpm mg:prod"
  },
  "dependencies": {
    "@apollo/client": "3.10.4",
    "@apollo/experimental-nextjs-app-support": "^0.10.1",
    "@apollo/server": "^4.10.4",
